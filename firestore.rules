rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user can access couple
    function canAccessCouple(coupleId, userId) {
      let couple = get(/databases/$(database)/documents/couples/$(coupleId)).data;
      return couple.createdBy == userId || couple.partnerUid == userId;
    }
    
    // Users can only access their own user document
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Couple profiles - strict access control
    match /couples/{coupleId} {
      // Read access: only couple members
      allow read: if request.auth != null && 
        (resource.data.createdBy == request.auth.uid || 
         resource.data.partnerUid == request.auth.uid);
      
      // Write access: only couple members
      allow write: if request.auth != null && 
        (resource.data.createdBy == request.auth.uid || 
         resource.data.partnerUid == request.auth.uid);
      
      // Create access: only by authenticated users for their own couples
      allow create: if request.auth != null && 
        request.resource.data.createdBy == request.auth.uid;
    }
    
    // Invitations - users can read their own invitations and create new ones
    match /invitations/{invitationId} {
      // Read: invited user can see their invitations, inviter can see theirs
      allow read: if request.auth != null && 
        (resource.data.inviterUid == request.auth.uid ||
         resource.data.inviteeEmail == request.auth.token.email);
      
      // Write: only inviter can update/delete, invitee can accept
      allow write: if request.auth != null && 
        (resource.data.inviterUid == request.auth.uid ||
         (resource.data.inviteeEmail == request.auth.token.email && 
          request.resource.data.status == 'accepted'));
      
      // Create: authenticated users can create invitations for their couples
      allow create: if request.auth != null && 
        request.resource.data.inviterUid == request.auth.uid &&
        exists(/databases/$(database)/documents/couples/$(request.resource.data.coupleId)) &&
        canAccessCouple(request.resource.data.coupleId, request.auth.uid);
    }
  }
}
