# Firebase Configuration
# Get these values from your Firebase Console: https://console.firebase.google.com/
# Go to Project Settings > General > Your apps > Web app > Config
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id_here
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id_here
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id_here

# Optional: Firebase Analytics Measurement ID
# NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id_here

# Spotify Configuration
# Get these from https://developer.spotify.com/dashboard/
NEXT_PUBLIC_SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here

# Development/Production Environment
NODE_ENV=development

# Optional: Custom App Settings
NEXT_PUBLIC_APP_NAME=SomeCoolName
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: Email Settings (if implementing email notifications)
# EMAIL_FROM=noreply@yourapp.com
# EMAIL_SERVER_HOST=smtp.yourprovider.com
# EMAIL_SERVER_PORT=587
# EMAIL_SERVER_USER=your_email_user
# EMAIL_SERVER_PASSWORD=your_email_password
